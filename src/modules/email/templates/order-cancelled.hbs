<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body style="margin:0;padding:0;background-color:#f4f6f8;font-family:Arial,Helvetica,sans-serif;color:#333333;">
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color:#f4f6f8;padding:24px 12px;">
    <tr>
      <td align="center">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="max-width:620px;background-color:#ffffff;border-radius:8px;overflow:hidden;border:1px solid #e4e7ea;">

          <tr>
            <td style="background-color:#b91c1c;padding:22px 24px;text-align:center;">
              <h1 style="margin:0;font-size:20px;line-height:1.3;color:#ffffff;font-weight:600;">Order Cancelled</h1>
              <p style="margin:6px 0 0;font-size:13px;color:#fee2e2;">Order #{{orderNumber}}</p>
            </td>
          </tr>

          <tr>
            <td style="padding:24px;">
              <p style="margin:0 0 14px;font-size:15px;">Dear {{customerName}},</p>
              <p style="margin:0 0 20px;font-size:15px;line-height:1.6;">
                Your order <strong>#{{orderNumber}}</strong> has been cancelled{{#if cancelledByLabel}} by {{cancelledByLabel}}{{/if}}.
                Any amount paid for this order will be refunded to your original payment method.
              </p>

              {{#if reason}}
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color:#fef2f2;border:1px solid #fecaca;border-radius:6px;margin:0 0 20px;">
                <tr><td style="padding:14px 16px;">
                  <p style="margin:0;font-size:14px;line-height:1.6;color:#991b1b;"><strong>Reason:</strong> {{reason}}</p>
                </td></tr>
              </table>
              {{/if}}

              {{#if showCustomer}}
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color:#fffbeb;border:1px solid #fde68a;border-radius:6px;margin:0 0 20px;">
                <tr><td style="padding:14px 16px;">
                  <p style="margin:0 0 8px;font-size:13px;font-weight:700;color:#92400e;text-transform:uppercase;letter-spacing:.04em;">Cancelled order for customer</p>
                  <p style="margin:0;font-size:14px;line-height:1.7;color:#78350f;">
                    <strong>Email:</strong> {{customerEmail}}<br>
                    {{#if customerPhone}}<strong>Phone:</strong> {{customerPhone}}<br>{{/if}}
                    <strong>Payment:</strong> {{paymentMethod}}<br>
                    <strong>Cancelled by:</strong> {{cancelledByLabel}}
                  </p>
                </td></tr>
              </table>
              {{/if}}

              <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border:1px solid #e4e7ea;border-radius:6px;margin:0 0 20px;">
                <tr>
                  <td colspan="2" style="padding:12px 16px;background-color:#f9fafb;border-bottom:1px solid #e4e7ea;border-radius:6px 6px 0 0;font-size:13px;font-weight:700;color:#374151;text-transform:uppercase;letter-spacing:.04em;">Order summary</td>
                </tr>
                <tr>
                  <td style="padding:10px 16px;font-size:14px;color:#6b7280;">Order number</td>
                  <td align="right" style="padding:10px 16px;font-size:14px;font-weight:600;">#{{orderNumber}}</td>
                </tr>
                <tr>
                  <td style="padding:10px 16px;font-size:14px;color:#6b7280;">Order date</td>
                  <td align="right" style="padding:10px 16px;font-size:14px;">{{orderDate}}</td>
                </tr>
                <tr>
                  <td style="padding:10px 16px;font-size:14px;color:#6b7280;">Cancelled on</td>
                  <td align="right" style="padding:10px 16px;font-size:14px;">{{cancelledDate}}</td>
                </tr>
              </table>

              <p style="margin:0 0 8px;font-size:13px;font-weight:700;color:#374151;text-transform:uppercase;letter-spacing:.04em;">Products in this order</p>
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border:1px solid #e4e7ea;border-radius:6px;margin:0 0 20px;">
                <tr>
                  <td colspan="3" style="padding:10px 16px;background-color:#f9fafb;border-bottom:1px solid #e4e7ea;font-size:12px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.04em;">Item</td>
                  <td align="right" style="padding:10px 16px;background-color:#f9fafb;border-bottom:1px solid #e4e7ea;font-size:12px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.04em;">Qty</td>
                  <td align="right" style="padding:10px 16px;background-color:#f9fafb;border-bottom:1px solid #e4e7ea;font-size:12px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.04em;">Amount</td>
                </tr>
                {{#each items}}
                <tr>
                  <td colspan="3" style="padding:12px 16px;font-size:14px;border-bottom:1px solid #f1f3f5;">
                    {{this.name}}
                    {{#if this.sku}}<br><span style="font-size:12px;color:#9ca3af;">SKU: {{this.sku}}</span>{{/if}}
                  </td>
                  <td align="right" style="padding:12px 16px;font-size:14px;border-bottom:1px solid #f1f3f5;white-space:nowrap;">{{this.quantity}}</td>
                  <td align="right" style="padding:12px 16px;font-size:14px;font-weight:600;border-bottom:1px solid #f1f3f5;white-space:nowrap;">&#8377;{{this.lineTotal}}</td>
                </tr>
                {{/each}}
              </table>

              <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:0 0 20px;">
                <tr>
                  <td style="padding:6px 0;font-size:14px;color:#6b7280;">Subtotal</td>
                  <td align="right" style="padding:6px 0;font-size:14px;">&#8377;{{subtotal}}</td>
                </tr>
                <tr>
                  <td style="padding:6px 0;font-size:14px;color:#6b7280;">Shipping</td>
                  <td align="right" style="padding:6px 0;font-size:14px;">&#8377;{{shippingAmount}}</td>
                </tr>
                {{#if hasDiscount}}
                <tr>
                  <td style="padding:6px 0;font-size:14px;color:#6b7280;">Discount</td>
                  <td align="right" style="padding:6px 0;font-size:14px;color:#059669;">&#8377;{{discountAmount}}</td>
                </tr>
                {{/if}}
                {{#if hasTax}}
                <tr>
                  <td style="padding:6px 0;font-size:14px;color:#6b7280;">Tax</td>
                  <td align="right" style="padding:6px 0;font-size:14px;">&#8377;{{taxAmount}}</td>
                </tr>
                {{/if}}
                <tr>
                  <td style="padding:12px 0 0;font-size:16px;font-weight:700;border-top:2px solid #b91c1c;">Final price</td>
                  <td align="right" style="padding:12px 0 0;font-size:18px;font-weight:700;border-top:2px solid #b91c1c;white-space:nowrap;">&#8377;{{totalAmount}}</td>
                </tr>
              </table>

              <p style="margin:0;font-size:14px;line-height:1.6;">If this was not expected, or you would like to place a new order, please contact our support team and we'll be happy to help.</p>

              <p style="margin:20px 0 0;text-align:center;">
                <a href="{{orderUrl}}" style="display:inline-block;padding:12px 24px;background-color:#b91c1c;color:#ffffff;text-decoration:none;border-radius:6px;font-size:14px;font-weight:600;">View your order</a>
              </p>
            </td>
          </tr>

          <tr>
            <td style="padding:16px 24px;background-color:#f9fafb;border-top:1px solid #e4e7ea;text-align:center;">
              <p style="margin:0 0 4px;font-size:12px;color:#6b7280;">&copy; {{year}} Dentzoo. All rights reserved.</p>
              <p style="margin:0;font-size:12px;color:#9ca3af;">This is an automated email. Please do not reply to this message.</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>